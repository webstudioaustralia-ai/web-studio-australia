# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/webstudio
REDIS_URL=redis://redis:6379

# Backend Configuration
NODE_ENV=development
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
API_SECRET_KEY=your_secret_key_here

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_WEBSOCKET_URL=ws://localhost:5000/ws
PORT=3000

# AI Agent Configuration
OPENAI_API_KEY=your_openai_api_key
AI_AGENT_PORT=8000
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7

# Live Chat Configuration
CHAT_SERVER_PORT=5001
CHAT_REDIS_URL=redis://redis:6379/1
MAX_CONNECTIONS=1000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@webstudioaustralia.com

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d

# Storage Configuration
S3_BUCKET=webstudio-australia
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Social Media
FACEBOOK_APP_ID=your_facebook_app_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# Stripe (for payments if needed)
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
